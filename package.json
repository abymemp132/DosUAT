{
  "name": "dosuat-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Automation testing setup with Playwright and TypeScript",
  "scripts": {
    "auth:manual": "tsx utils/manualAuth.ts",
    "test": "tsx utils/runTestsWithDashboard.ts",
    "test:raw": "playwright test",
    "test:full": "playwright test --config playwright.full.config.ts",
    "test:full:raw": "playwright test --config playwright.full.config.ts",
    "test:headed": "playwright test --headed",
    "test:open": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:staging": "cross-env TEST_ENV=staging playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test",
    "report:pdf": "tsx scripts/generate-report.ts",
    "send-email": "tsx scripts/email-sender.ts",
    "pipeline": "tsx utils/runPipeline.ts",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "deploy:report": "tsx scripts/deploy-netlify.ts report",
    "deploy:dashboard": "tsx scripts/deploy-netlify.ts dashboard",
    "dashboard:static": "node utils/generateTestDashboard.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^1.6.0",
    "nodemailer": "^8.0.5",
    "prettier": "^3.2.5",
    "puppeteer": "^24.41.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "node-cron": "^4.6.0"
  }
}
