# Test Environment (dev, staging, prod)
TEST_ENV=staging

# Website Credentials
WEBSITE_USERNAME=your_username
WEBSITE_PASSWORD=your_password

# SMTP Configuration (For Email Notifications)
# For Gmail, use an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_RECIPIENTS=manager@example.com,dev-team@example.com

# Netlify Configuration (For Hosting Reports)
NETLIFY_AUTH_TOKEN=your_netlify_token
NETLIFY_SITE_ID=your_site_id

# Playwright Output (Optional overrides)
PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report
PLAYWRIGHT_JSON_OUTPUT_NAME=reports/results.json
